# All values below are FAKE placeholders showing the expected format —
# replace every one with your own real values. See guide.txt for exactly
# where to find each one (Firebase console, Cloudinary dashboard). Never
# commit your real .env file.

# ── Firebase (Project settings → General → Your apps → SDK setup) ──────
VITE_FIREBASE_API_KEY=AIzaSyD-REPLACE_WITH_YOUR_OWN_KEY_0000
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789000
VITE_FIREBASE_APP_ID=1:123456789000:web:abc123def456abc789

# ── Cloudinary (Dashboard + Settings → Upload → Upload presets) ────────
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=mavero-unsigned

# ── Admin bootstrap (used ONLY by `npm run create-admin`, never by the ──
# app itself — deliberately NOT prefixed with VITE_ so it's never bundled
# into client-side code. See guide.txt Part 2.6.) ───────────────────────
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123

# ── OPTIONAL: fully automates the one manual console step in ───────────
# `npm run create-admin` (see guide.txt Part 2.6, "Option A+"). Leave
# blank/absent and the command still works — it just prints a link for
# you to flip the role field yourself instead. Get these two values from
# a service-account key: Firebase Console → Project settings → Service
# accounts → Generate new private key (downloads a JSON file) → copy its
# "client_email" and "private_key" fields below exactly as they appear.
# This credential can bypass every Firestore security rule in the
# project — never commit it, never put it in anything VITE_-prefixed.
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKj\n...paste every line from the downloaded JSON's private_key here...\n-----END PRIVATE KEY-----\n"
